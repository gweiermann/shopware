{
  "repo": "gweiermann/shopware",
  "upstream": "shopware/shopware",
  "defaultIssue": 30,
  "model": "gpt-5.4",
  "reasoningEffort": "low",
  "sandbox": "danger-full-access",
  "maxTurns": 12,
  "workflow": ".github/workflows/repro-agent.lock.yml",
  "agentVerifyCommand": "bash .github/actions/repro-agent/bin/agent/verify-reproduction.sh",
  "agentShopGetCommand": "bash .github/actions/repro-agent/bin/agent/shop-get.sh",
  "generatedArtifacts": [
    "build-context.md",
    "issue.md",
    "fixpr.diff",
    "issue-class.txt",
    "issue-assets",
    "reproduction-plan.json",
    "fixtures.json",
    "repro.spec.ts",
    "repro.sh",
    "ReproTest.php",
    "builder-result.json",
    "result.json",
    "seed-error.txt",
    "pw-report.json",
    "pw-stdout.txt",
    "pw-stderr.txt",
    "test-results",
    "playwright-report",
    ".github/actions/repro-agent/repro.spec.ts",
    ".repro-agent-local-restore",
    "admin-state.json",
    "customer-addresses-example.json",
    "tests/integration/Repro"
  ],
  "evalSet": [
    {
      "name": "issue-30-cms-product-slider-variant",
      "issue": 30,
      "expectedExecutor": "playwright",
      "visual": true
    }
  ]
}
